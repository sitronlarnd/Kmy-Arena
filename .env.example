# ─────────────────────────────────────────────────────────────
# KMY Arena — ortam değişkenleri şablonu
# Bu dosyayı .env olarak kopyala ve değerleri doldur.
# GİZLİ değerler (anahtarlar) yalnızca sunucu tarafında (Vercel ortam
# değişkenleri / .env) durur; EXPO_PUBLIC_ ve NEXT_PUBLIC_ ile başlayan
# değişkenler istemci paketine girer, oraya ASLA gizli anahtar yazma.
# ─────────────────────────────────────────────────────────────

# ── Supabase (Cloud Pro, Frankfurt / eu-central-1) ──
SUPABASE_URL=https://<proje-ref>.supabase.co
SUPABASE_ANON_KEY=
# Sunucu tarafı tam yetkili anahtar — istemciye asla verilmez.
SUPABASE_SERVICE_ROLE_KEY=
# Doğrudan Postgres bağlantısı (migration ve CI veritabanı testleri için)
DATABASE_URL=postgresql://postgres:<sifre>@db.<proje-ref>.supabase.co:5432/postgres
# KVKK: veritabanı bölgesi. Yurt dışı (AB) seçildiği için docs/KVKK.md notuna bak.
VERI_BOLGESI=eu-central-1

# İstemcilere giden herkese açık değerler (anon anahtar RLS ile korunur)
EXPO_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=https://api.<alanadi>
NEXT_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── KMYAI (OpenAI uyumlu chat-completions) ──
KMYAI_BASE_URL=https://www.kmyai.cloud/api/v1
# Anahtarı kendin gir; koda, depoya veya sohbete yazılmaz.
KMYAI_API_KEY=
# Görev bazlı modeller. Merkez Panel > AI Merkezi'ndeki ayar bunları ezer;
# buradaki değerler veritabanında ayar yoksa kullanılan varsayılanlardır.
KMYAI_MODEL_URETICI=claude-sonnet-4-6
KMYAI_MODEL_DOGRULAYICI=claude-sonnet-5-5
KMYAI_MODEL_ASISTAN=claude-sonnet-4-6
KMYAI_MODEL_GORSEL=claude-sonnet-4-6
KMYAI_MODEL_VELI_RAPORU=claude-sonnet-4-6
KMYAI_MODEL_YEDEK=claude-haiku-4-5
# Zaman aşımları (ms) ve yeniden deneme sayısı
KMYAI_ZAMAN_ASIMI_URETIM_MS=20000
KMYAI_ZAMAN_ASIMI_ASISTAN_MS=30000
KMYAI_YENIDEN_DENEME=2

# ── Gerçek zamanlı katman ──
# supabase | ozel  (500 eşzamanlı bağlantı aşılınca 'ozel' sunucuya geçiş)
REALTIME_SAGLAYICI=supabase
REALTIME_OZEL_URL=

# ── Arka plan işleri ──
# Vercel Cron isteklerini doğrulamak için (Vercel otomatik Authorization: Bearer ekler)
CRON_SECRET=

# ── E-posta (Resend) ──
RESEND_API_KEY=
EPOSTA_GONDEREN=KMY Arena <bildirim@<alanadi>>
# Teklif formu ve pilot bildirimlerinin gideceği adres (senin adresin)
SAHIP_EPOSTA=

# ── Gözlemleme ──
SENTRY_DSN=
