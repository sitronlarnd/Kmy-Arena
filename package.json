{
  "name": "kmy-arena",
  "private": true,
  "version": "0.1.0",
  "description": "KMY Arena — dershaneler için AI destekli, oyunlaştırılmış soru çözme platformu",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm -r test",
    "db:test": "bash scripts/db-test.sh",
    "dogrula": "pnpm lint && pnpm typecheck && pnpm test && pnpm db:test",
    "dogrula:cekirdek": "bash scripts/dogrula-cekirdek.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
